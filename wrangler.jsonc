{
  // Sitio estático servido desde Cloudflare Workers (sin código de servidor).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "rojohernandezpablo.com", "custom_domain": true },
    { "pattern": "www.rojohernandezpablo.com", "custom_domain": true }
  ]
}
